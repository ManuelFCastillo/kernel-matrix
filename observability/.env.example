# Copy to .env and fill in. .env is gitignored and never committed.
#
#   cp .env.example .env && chmod 600 .env
#
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=pick-something-real

# Where provision.py writes results, bind-mounted read-only into the
# report container. Absolute path.
KM_RESULTS=/home/mcastill/kernel-matrix/results
